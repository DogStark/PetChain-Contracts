# celo-contracts/.npmrc
# Dependency source policy (issue #1349).
#
# All npm packages must be resolved from the public npm registry.
# Private or alternative registries are not approved for production artifacts.
# Any deviation requires a PR review and a versioned exception in
# docs/dependency-policy.md.
registry=https://registry.npmjs.org/

# Enforce lockfile-reproducible installs in CI.
# `npm ci` already requires package-lock.json; this prevents accidental `npm
# install` from silently updating the lockfile.
engine-strict=false
save-exact=false
